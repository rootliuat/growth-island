{
  "name": "growth-island",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:vite": "vite --host 0.0.0.0",
    "api": "node server/beihai-api.mjs",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "npm run typecheck && vite build && node scripts/check-build-budget.mjs",
    "qa:visual": "node scripts/qa-visual.mjs",
    "qa:trial": "npm run build && node scripts/qa-trial.mjs",
    "qa:trial:fast": "TRIAL_QA_CHECKS=home,moral-speak-flow TRIAL_REQUIRED_RESULTS=home/whiteboard,moral-speak-flow/whiteboard,moral-speak-flow/mobile node scripts/qa-trial.mjs",
    "qa:trial-assets": "node scripts/check-trial-assets.mjs",
    "qa:preview-smoke": "node scripts/qa-preview-smoke.mjs",
    "qa:p0-trace": "node scripts/qa-p0-trace.mjs",
    "qa:p4-providers": "node scripts/qa-p4-provider-smoke.mjs",
    "qa:release:auto": "npm test && npm run build && npm run qa:trial:fast && npm run qa:preview-smoke",
    "qa:real-mic": "npm run build && node scripts/qa-real-mic.mjs",
    "assets:map-hidpi": "node scripts/generate-map-hidpi.mjs",
    "assets:map-webp": "node scripts/generate-map-webp.mjs",
    "assets:thumbs": "node scripts/generate-spirit-thumbnails.mjs",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.1.1",
    "lucide-react": "^0.561.0",
    "pixi-viewport": "^6.0.3",
    "pixi.js": "^8.18.1",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "three": "^0.184.0",
    "vite": "^7.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.19.19",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.184.1",
    "playwright": "^1.60.0",
    "sharp": "^0.34.5",
    "typescript": "^5.9.3",
    "vitest": "^4.1.7"
  }
}
