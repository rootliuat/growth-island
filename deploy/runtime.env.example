# [INPUT]: 依赖部署者提供的腾讯/DeepSeek 凭据和持久磁盘路径。
# [OUTPUT]: 对外定义单实例课堂 API 的监听、存储、Provider 与超时环境变量模板。
# [POS]: deploy 的无密钥配置样本，复制到 /etc/growth-island/runtime.env 后由 systemd 读取。
# [PROTOCOL]: 变更时更新此头部，然后检查 CLAUDE.md

HOST=127.0.0.1
PORT=5174
RELEASE_VERSION=
BEIHAI_DB_PATH=/var/lib/growth-island/classroom.json
REQUEST_BODY_LIMIT_BYTES=5242880
PROVIDER_TIMEOUT_MS=12000
TENCENT_TIMEOUT_MS=12000
TENCENT_ASR_REGION=ap-guangzhou
TENCENT_ASR_ENGINE=16k_zh
TENCENT_ASR_SECRET_ID=
TENCENT_ASR_SECRET_KEY=
LLM_PROVIDER=deepseek
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_MS=12000
DEEPSEEK_API_KEY=
